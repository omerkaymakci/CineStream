# API Gateway base URL. Movie/genre endpoints are served under /movie-service.
VITE_API_BASE_URL=http://localhost:8080/movie-service

# Keycloak
VITE_KEYCLOAK_URL=http://localhost:9000
VITE_KEYCLOAK_REALM=cinestream
VITE_KEYCLOAK_CLIENT_ID=cinestream-frontend
# Only if the Keycloak client is confidential (Client authentication ON).
# Leave empty for a public client (recommended for a browser app).
# VITE_KEYCLOAK_CLIENT_SECRET=
